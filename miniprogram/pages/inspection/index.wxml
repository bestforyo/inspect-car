<view class="page inspect-page">
  <view wx:if="{{templateUnavailable}}" class="motorcycle-notice card">摩托车专用检测模板尚未配置。为避免套用乘用车检测项目，本版本暂不开放摩托车现场录入。</view>
  <view wx:if="{{!templateUnavailable}}" class="summary card">
    <view class="sum-top"><view><view class="sum-title">现场检测记录</view><view class="muted">{{business==='motorcycle'?'摩托车':'乘用车'}} · {{kind==='new'?'新车':'二手车'}} · 本机草稿</view></view><view class="draft-badge">自动保存</view></view>
    <view class="progress-row"><text>已记录 {{done}} / {{total}} 项</text><text class="blue">{{progressPercent}}%</text></view>
    <view class="track"><view class="fill" style="width:{{progressPercent}}%"></view></view>
  </view>
  <scroll-view scroll-x class="tabs">
    <view class="tab {{active==='major'?'active':''}}" data-id="major" bindtap="switchGroup">重大事故 <text>{{counts[0].done}}/{{counts[0].total}}</text></view>
    <view class="tab {{active==='water'?'active':''}}" data-id="water" bindtap="switchGroup">泡水 <text>{{counts[1].done}}/{{counts[1].total}}</text></view>
    <view class="tab {{active==='fire'?'active':''}}" data-id="fire" bindtap="switchGroup">火烧 <text>{{counts[2].done}}/{{counts[2].total}}</text></view>
  </scroll-view>
  <view class="search-box"><text class="search-symbol">⌕</text><input placeholder="搜索检测项目或车辆区域" value="{{keyword}}" bindinput="onSearch" confirm-type="search"/><text wx:if="{{keyword}}" class="clear-search" bindtap="clearSearch">清除</text></view>
  <block wx:for="{{visibleGroups}}" wx:key="id">
    <view wx:if="{{active===item.id}}">
      <view class="section-title">{{item.title}} <text class="muted small">{{item.items.length}} 项</text></view>
      <view class="check-card card" wx:for="{{item.items}}" wx:for-item="check" wx:key="id">
        <view class="check-head"><view class="check-title-wrap"><text class="check-name">{{check.name}}</text><text class="section-tag">{{check.section}}</text></view><text class="state {{check.state==='正常'?'state-ok':check.state==='待检测'?'state-pending':'state-alert'}}">{{check.state}}</text></view>
        <scroll-view scroll-x class="state-scroll"><view class="state-row"><text wx:for="{{states}}" wx:for-item="s" wx:key="*this" class="state-chip {{check.state===s?'chosen':''}}" data-group="{{item.id}}" data-item="{{check.id}}" data-state="{{s}}" bindtap="selectState">{{s}}</text></view></scroll-view>
        <view class="check-actions"><text class="muted note" data-group="{{item.id}}" data-item="{{check.id}}" bindtap="addNote">{{check.note || "＋ 添加文字说明"}}</text><text class="photo-action" data-group="{{item.id}}" data-item="{{check.id}}" bindtap="addPhoto">＋ 照片 {{check.photos.length}}/9</text></view>
        <view wx:if="{{check.photos.length}}" class="photo-list">
          <view class="photo-wrap" wx:for="{{check.photos}}" wx:for-item="photo" wx:key="*this">
            <image src="{{photo}}" mode="aspectFill" data-group="{{item.id}}" data-item="{{check.id}}" data-src="{{photo}}" bindtap="previewPhoto"/>
            <text class="photo-remove" data-group="{{item.id}}" data-item="{{check.id}}" data-src="{{photo}}" catchtap="removePhoto">×</text>
          </view>
        </view>
      </view>
    </view>
  </block>
  <view wx:if="{{!visibleGroups.length}}" class="empty">没有找到匹配的检测项目</view>
  <button wx:if="{{!templateUnavailable}}" class="primary submit-btn" bindtap="submit">提交审核（演示）</button>
  <view class="disclaimer">检测项目来源于竞品截图转录；标准适用性和事故判定规则尚未核验。本版本不生成正式检测结论。</view>
</view>