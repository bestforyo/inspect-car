.summary{padding:26rpx}.sum-title{font-size:30rpx;font-weight:800;margin-bottom:8rpx}.progress-row{display:flex;justify-content:space-between;font-size:22rpx;margin-top:28rpx}.track{height:10rpx;background:#EDF0F5;border-radius:10rpx;margin-top:14rpx;overflow:hidden}.fill{height:100%;background:#2475E8;border-radius:10rpx}.tabs{white-space:nowrap;margin:10rpx 0 22rpx}.tab{display:inline-block;padding:18rpx 26rpx;background:#E9EDF3;border-radius:14rpx;margin-right:12rpx;color:#66758A;font-size:24rpx}.tab text{font-size:20rpx;margin-left:8rpx}.tab.active{background:#E6F0FF;color:#2475E8;font-weight:700}.check-card{padding:22rpx;margin-bottom:14rpx}.check-head{display:flex;justify-content:space-between;align-items:center}.check-name{font-size:25rpx;font-weight:700}.state{font-size:21rpx;color:#2475E8}.state-scroll{margin-top:20rpx;white-space:nowrap}.state-chip{display:inline-block;padding:10rpx 16rpx;border-radius:10rpx;background:#F1F3F6;color:#68778A;font-size:21rpx;margin-right:10rpx}.state-chip.chosen{background:#E6F0FF;color:#2475E8;font-weight:700}.check-actions{display:flex;justify-content:space-between;margin-top:20rpx;font-size:21rpx}.note{max-width:58%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.photo-action{color:#2475E8}.submit-btn{margin:26rpx 0 16rpx}.disclaimer{text-align:center;color:#9AA5B3;font-size:20rpx;line-height:1.6;padding-bottom:30rpx}
.photo-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.photo-list image{width:112rpx;height:112rpx;border-radius:12rpx;background:#F1F3F6}
