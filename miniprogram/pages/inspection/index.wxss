.summary{padding:26rpx}.sum-top{display:flex;justify-content:space-between;align-items:center}.sum-title{font-size:30rpx;font-weight:800;margin-bottom:8rpx}.draft-badge{font-size:20rpx;color:#2674D9;background:#EAF2FF;padding:9rpx 15rpx;border-radius:20rpx}.progress-row{display:flex;justify-content:space-between;font-size:22rpx;margin-top:28rpx}.track{height:10rpx;background:#EDF0F5;border-radius:10rpx;margin-top:14rpx;overflow:hidden}.fill{height:100%;background:#2475E8;border-radius:10rpx}.tabs{white-space:nowrap;margin:10rpx 0 20rpx}.tab{display:inline-block;padding:18rpx 24rpx;background:#E9EDF3;border-radius:14rpx;margin-right:12rpx;color:#66758A;font-size:24rpx}.tab text{font-size:20rpx;margin-left:8rpx}.tab.active{background:#E6F0FF;color:#2475E8;font-weight:700}.search-box{height:76rpx;background:#fff;border-radius:16rpx;display:flex;align-items:center;padding:0 22rpx;margin-bottom:24rpx}.search-symbol{font-size:38rpx;color:#7B8CA3;margin-right:14rpx}.search-box input{flex:1;font-size:24rpx}.clear-search{font-size:22rpx;color:#2475E8}.check-card{padding:22rpx;margin-bottom:14rpx}.check-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12rpx}.check-title-wrap{display:flex;flex-direction:column;gap:8rpx}.check-name{font-size:25rpx;font-weight:700}.section-tag{font-size:19rpx;color:#8A96A6}.state{font-size:21rpx;white-space:nowrap}.state-ok{color:#199B69}.state-pending{color:#8995A6}.state-alert{color:#D9822B}.state-scroll{margin-top:20rpx;white-space:nowrap}.state-chip{display:inline-block;padding:10rpx 16rpx;border-radius:10rpx;background:#F1F3F6;color:#68778A;font-size:21rpx;margin-right:10rpx}.state-chip.chosen{background:#E6F0FF;color:#2475E8;font-weight:700}.check-actions{display:flex;justify-content:space-between;align-items:center;margin-top:20rpx;font-size:21rpx}.note{max-width:58%;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.photo-action{color:#2475E8}.photo-list{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.photo-wrap{width:112rpx;height:112rpx;position:relative}.photo-wrap image{width:112rpx;height:112rpx;border-radius:12rpx;background:#F1F3F6}.photo-remove{position:absolute;right:-8rpx;top:-8rpx;width:34rpx;height:34rpx;line-height:32rpx;text-align:center;border-radius:50%;background:rgba(0,0,0,.65);color:#fff;font-size:28rpx}.submit-btn{margin:26rpx 0 16rpx}.disclaimer{text-align:center;color:#9AA5B3;font-size:20rpx;line-height:1.6;padding-bottom:30rpx}.empty{text-align:center;padding:80rpx 0;color:#9AA5B3;font-size:24rpx}.small{font-size:21rpx;font-weight:400;margin-left:10rpx}
.motorcycle-notice{padding:28rpx;color:#9A642D;background:#FFF7EA;line-height:1.7;font-size:23rpx}
