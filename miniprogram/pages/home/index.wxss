.hero{background:linear-gradient(135deg,#101C33,#1C3964);border-radius:28rpx;padding:32rpx;color:white;margin-bottom:36rpx}.hero-top{display:flex;justify-content:space-between;align-items:center}.brand{font-size:40rpx;font-weight:800;letter-spacing:2rpx}.brand text{font-size:20rpx;color:#8FB9F8;letter-spacing:3rpx;margin-left:8rpx}.hero-sub{font-size:22rpx;color:#B6C8E2;margin-top:10rpx}.avatar{width:72rpx;height:72rpx;border-radius:50%;background:#294A77;display:flex;align-items:center;justify-content:center;font-size:28rpx}.hero-date{font-size:22rpx;color:#AFC2DC;margin-top:34rpx}.hero-stats{display:flex;margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #385171}.hero-stats>view{flex:1}.stat-num{font-size:38rpx;font-weight:700}.stat-label{font-size:21rpx;color:#B6C8E2;margin-top:6rpx}.small{font-size:21rpx;font-weight:400;margin-left:10rpx}.type-grid{display:flex;gap:18rpx}.type-card{position:relative;background:white;border-radius:22rpx;padding:26rpx 22rpx;flex:1;min-height:190rpx;box-shadow:0 8rpx 28rpx rgba(21,43,76,.04)}.type-icon{width:64rpx;height:64rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:28rpx;margin-bottom:22rpx}.car{background:#EAF2FF;color:#2475E8}.moto{background:#FFF2E8;color:#E58A37}.type-name{font-size:28rpx;font-weight:700}.type-desc{font-size:21rpx;color:#8995A6;margin-top:8rpx}.type-arrow,.right-arrow{position:absolute;right:22rpx;bottom:24rpx;color:#A8B3C2;font-size:34rpx}.search-card{background:#EAF2FF;border-radius:20rpx;padding:24rpx;display:flex;align-items:center;margin:28rpx 0 36rpx;position:relative}.search-icon{font-size:46rpx;color:#2475E8;margin-right:20rpx}.search-title{font-size:27rpx;font-weight:700;margin-bottom:6rpx}.recent{padding:24rpx;margin-bottom:14rpx}.recent-head,.recent-foot{display:flex;justify-content:space-between;align-items:center}.recent-car{font-weight:700;font-size:26rpx}.recent-foot{margin-top:18rpx;font-size:20rpx}.foot-note{text-align:center;color:#A3ADBA;font-size:20rpx;padding:28rpx 0}
.quick-actions{display:flex;gap:12rpx;margin:22rpx 0}.quick-action{flex:1;text-align:center;padding:20rpx 8rpx;border-radius:14rpx;background:#fff;color:#53647A;font-size:21rpx}.primary-action{background:#2475E8;color:#fff}.empty-recent{text-align:center;color:#9AA5B3;background:#fff;border-radius:18rpx;padding:38rpx;font-size:22rpx}
