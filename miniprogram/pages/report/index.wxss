.report{background:#fff;border-radius:18rpx;padding:30rpx}.report-head{text-align:center;padding:22rpx 0 30rpx;border-bottom:2rpx solid #26364E}.brand{font-size:22rpx;letter-spacing:3rpx;color:#2475E8;font-weight:800}.report-title{font-size:34rpx;font-weight:800;margin:20rpx 0 10rpx}.report-id{font-size:20rpx;color:#8995A6}.report-section{padding:26rpx 0;border-bottom:1rpx solid #E9EDF2}.section-title{font-size:26rpx;font-weight:800;margin-bottom:18rpx}.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;font-size:21rpx}.report-section>view:not(.section-title){font-size:22rpx;margin-top:10rpx}.group{margin-bottom:18rpx}.group-title{font-size:23rpx;font-weight:700;background:#F3F6FA;padding:12rpx;border-radius:8rpx}.result{padding:15rpx 8rpx;border-bottom:1rpx solid #F0F2F5}.result-top{display:flex;justify-content:space-between;font-size:21rpx}.result-state{color:#2475E8}.note{font-size:19rpx;margin-top:8rpx}.photos{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:10rpx}.photos image{width:100rpx;height:100rpx;border-radius:8rpx}.disclaimer{font-size:20rpx;color:#A06D45;line-height:1.6;padding:24rpx 4rpx}.empty{text-align:center;padding:100rpx 0;color:#9AA5B3}