.profile-hero{display:flex;align-items:center;padding:34rpx 10rpx 38rpx}.profile-avatar{width:100rpx;height:100rpx;border-radius:28rpx;background:#DCEAFF;color:#2475E8;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:800;margin-right:24rpx}.profile-name{font-size:34rpx;font-weight:800}.profile-role{color:#8A96A6;font-size:22rpx;margin-top:8rpx}.edit{margin-left:auto;font-size:42rpx;color:#9AA5B3}.stats{display:flex;justify-content:space-around;text-align:center;padding:28rpx 8rpx}.number{font-size:36rpx;font-weight:800;margin-bottom:8rpx}.stats .muted{font-size:21rpx}.menu-card{padding:0 26rpx}.menu{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #F0F2F5;font-size:26rpx}.menu:last-child{border:0}.version{text-align:center;color:#A4AFBD;font-size:20rpx;margin-top:46rpx}