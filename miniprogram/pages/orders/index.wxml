<view class="page"><view class="page-head"><view><view class="page-title">检测订单</view><view class="muted">本机订单记录</view></view><button size="mini" class="primary" bindtap="create">＋ 新建</button></view><scroll-view scroll-x class="filters"><text class="filter {{filter==='all'?'on':''}}" data-value="all" bindtap="filterTap">全部</text><text class="filter {{filter==='draft'?'on':''}}" data-value="draft" bindtap="filterTap">待开始</text><text class="filter {{filter==='in_progress'?'on':''}}" data-value="in_progress" bindtap="filterTap">检测中</text><text class="filter {{filter==='pending_review'?'on':''}}" data-value="pending_review" bindtap="filterTap">待审核</text><text class="filter {{filter==='needs_revision'?'on':''}}" data-value="needs_revision" bindtap="filterTap">待修改</text><text class="filter {{filter==='approved'?'on':''}}" data-value="approved" bindtap="filterTap">已审核</text></scroll-view><view wx:for="{{orders}}" wx:key="id" class="card order-card" data-id="{{item.id}}" bindtap="open"><view class="order-top"><text class="car">{{item.vehicle.brandModel || '未填写车型'}}</text><text class="status">{{item.statusText}}</text></view><view class="muted meta">{{item.vehicle.plate || '未填写车牌'}} · {{item.vehicle.vin || '未填写 VIN'}}</view><view class="order-foot"><text class="muted">{{item.id}}</text><text class="muted">{{item.updatedAt}}</text></view><view class="order-actions"><button wx:if="{{item.status==='draft'||item.status==='in_progress'||item.status==='needs_revision'}}" size="mini" class="continue-btn" catchtap="continueInspection" data-id="{{item.id}}">继续检测</button><button wx:if="{{item.status==='pending_review'}}" size="mini" class="review-btn" catchtap="review" data-id="{{item.id}}">进入审核</button></view></view><view wx:if="{{!orders.length}}" class="empty"><view>暂无订单</view><button class="primary" size="mini" bindtap="create">创建第一份检测订单</button></view><view class="hint">订单数据仅保存在本机，非云端业务记录。</view></view>