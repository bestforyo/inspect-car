<view class="page"><view class="page-title">审核工作台</view><view class="muted sub">待审核及需修改的本机订单</view><view class="queue"><view wx:for="{{queue}}" wx:key="id" class="queue-item card" data-id="{{item.id}}" bindtap="choose"><view class="q-title">{{item.vehicle.brandModel}}</view><view class="muted">{{item.id}} · {{item.status==='pending_review'?'待审核':'待修改'}}</view></view></view><view wx:if="{{order}}" class="card detail"><view class="detail-title">审核对象</view><view>{{order.vehicle.brandModel}}</view><view class="muted">{{order.vehicle.plate}} · {{order.id}}</view><view class="review-note">检测记录：{{order.inspection?order.inspection.done:0}} / {{order.inspection?order.inspection.total:0}} 项已记录</view><textarea placeholder="审核意见、补充材料要求" value="{{note}}" bindinput="onNote"/><view class="actions"><button size="mini" class="return" bindtap="returnEdit">退回修改</button><button size="mini" class="primary" bindtap="approve">审核通过</button></view><button class="report-btn" size="mini" bindtap="report">预览报告</button></view><view wx:else class="empty">请从上方选择一份待审核订单</view><view class="hint">审核状态仅用于本机流程演示，不构成真实审核或签发。</view></view>