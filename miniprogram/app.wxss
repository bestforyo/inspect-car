page{background:#F3F6FA;color:#17243A;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}button{border-radius:16rpx}button::after{border:0}.page{padding:28rpx}.card{background:#fff;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx;box-shadow:0 8rpx 28rpx rgba(21,43,76,.04)}.muted{color:#8995A6}.blue{color:#2475E8}.primary{background:#2475E8;color:#fff}.section-title{font-size:32rpx;font-weight:700;margin:10rpx 0 22rpx}.pill{display:inline-block;padding:8rpx 16rpx;border-radius:999rpx;background:#EDF4FF;color:#2475E8;font-size:22rpx}