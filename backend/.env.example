NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000

# Configure these only in a secret manager or local untracked .env file.
DATABASE_URL=mysql://inspect_car:change-me@127.0.0.1:3306/inspect_car
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-characters
WX_APP_ID=
WX_APP_SECRET=

# Tencent Cloud COS/CDN credentials are intentionally not committed.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
CDN_BASE_URL=